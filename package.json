{
  "name": "thuattoangenditruyen-tkb-tudong",
  "version": "1.0.0",
  "description": "Timetable generator for university schedule implemented in Python using *genetic algorithms*.",
  "main": "server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "node server.js",
    "seed:khung": "node scripts/bootstrap_time_slots.js",
    "seed:khung:dry": "node scripts/bootstrap_time_slots.js --dry-run",
    "seed:assignments": "node scripts/bootstrap_assignments.js",
    "seed:assignments:dry": "node scripts/bootstrap_assignments.js --dry-run",
    "seed:all": "node scripts/bootstrap_time_slots.js && node scripts/bootstrap_assignments.js",
    "docker:build": "docker build -t tkb-app:latest .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:rebuild": "docker-compose down && npm run docker:build && npm run docker:up"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nguyenvietduc795/ThuatToanGenDiTruyen-TKB-TuDong.git"
  },
