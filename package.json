  },
  "homepage": "https://github.com/Nguyenvietduc795/ThuatToanGenDiTruyen-TKB-TuDong#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.103.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1"
  }
  
}
