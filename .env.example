# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Server Configuration
PORT=3000
NODE_ENV=production

# Python Configuration
PYTHONUNBUFFERED=1
PYTHONIOENCODING=utf-8
PYTHON_EXECUTABLE=python

# Optional: Special room configurations
# SPECIAL_TH_ROOM_MAMONS=IT01,IT02,AI01
# SPECIAL_5TIET_MAMONS=TTNT,AI,TTDL
# Special assignments for bootstrap: LT-only subjects that must use 5 periods per session
# SEED_5TIET_LT_ONLY=TTNT,AI,TTDL